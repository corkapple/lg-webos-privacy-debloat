#!/bin/sh
# Blocks LG's ad/ACR/telemetry/recommendation/IoT domains at the hosts level,
# via a bind-mount since /etc/hosts is read-only on this firmware.
#
# This needs a companion domain list -- see lg-ads-blocklist.txt in this same
# directory, sourced from github.com/furkan-bayrak/lg-tv-blocklist's STRICT
# tier (209 entries; 6 firmware-update domains removed so you keep the
# ability to get security patches -- see that file's header for which ones
# and why).
#
# Install as root:
#
#   cp 80-block-lg-ads /var/lib/webosbrew/init.d/80-block-lg-ads
#   cp lg-ads-blocklist.txt /var/lib/webosbrew/lg-blocklist.txt
#   chmod +x /var/lib/webosbrew/init.d/80-block-lg-ads
#   sh /var/lib/webosbrew/init.d/80-block-lg-ads   # apply immediately
#
# IMPORTANT, learned the hard way: never build the new hosts file by reading
# the *live*, already-bind-mounted /etc/hosts in the same command that writes
# its own backing file (e.g. `cat /etc/hosts > hosts-base`). Both paths point
# at the same underlying file once bind-mounted, so the write truncates it
# out from under the read and the original content -- including the
# `localhost` entries -- is simply gone, silently, with no error. This
# script instead makes ONE pristine backup the first time it ever runs, and
# rebuilds from that backup on every later boot, never from the live file.
if [ ! -f /var/lib/webosbrew/hosts-original ]; then
  umount /etc/hosts 2>/dev/null
  cp /etc/hosts /var/lib/webosbrew/hosts-original
fi
cat /var/lib/webosbrew/hosts-original /var/lib/webosbrew/lg-blocklist.txt > /var/lib/webosbrew/hosts-base
mount --bind /var/lib/webosbrew/hosts-base /etc/hosts
exit 0
